# Runtime state stays outside git on the VPS.
TIKTOK_BACKOFFICE_DB=/opt/data/tiktok-backoffice/tiktok_backoffice.sqlite3

# Existing login/session material must stay outside git.
TIKTOK_MS_TOKEN_FILE=/opt/data/meta-comment-dm-automation/data/tiktok_login_tool_token.txt

# Hard safety gate: current implementation is draft-only. Do not set this unless
# a future reviewed implementation explicitly supports publishing.
TIKTOK_CONFIRM_PUBLISH=
