# Meta App
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Tokens
# Do not store production tokens in plain text for a real deployment.
META_USER_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_TOKEN_RENEWAL_DEPLOY_TRIGGER=.deploy-trigger

# IDs
META_PAGE_ID=
META_IG_USER_ID=
# Optional comma-separated owner identities used to ignore/reconcile your own replies.
# META_PAGE_ID and META_IG_USER_ID are included automatically.
META_OWNER_IDS=
META_OWNER_USERNAMES=dupflodev

# Automation
RESOURCE_KEYWORD=proxy
RESOURCE_URL=https://example.com/resource
PUBLIC_REPLY_TEXT=C'est envoyé, check tes DM
PROCESSED_COMMENTS_DATABASE=data/processed_comments.sqlite3
# Comma-separated keywords that are interest signals only, not resource-delivery campaigns.
# Example: MIGRATION means "I want the future video", not "send me a link".
INTEREST_ONLY_KEYWORDS=migration
GRAPH_API_VERSION=v21.0
