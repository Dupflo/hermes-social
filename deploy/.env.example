# Hermes Social — runtime secrets. Copy to .env and fill in.
# NEVER commit .env — the repo is public and .gitignore excludes it.

# Admin login for the Hermes web UI
ADMIN_USERNAME=hermes
ADMIN_PASSWORD=            # openssl rand -base64 24

# Telegram gateway (via @BotFather)
TELEGRAM_BOT_TOKEN=

# GitHub PAT — Skills Hub + private repo clones
GITHUB_TOKEN=

# Web search — set ONE of these to enable the search tool
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# ── Social APIs (fill in as tools come online) ──────────────────────────────
# Meta (Facebook / Instagram) — used by social/tools/meta-webhook.
# Full reference: social/tools/meta-webhook/.env.example
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_USER_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
RESOURCE_KEYWORD=proxy
RESOURCE_URL=
PUBLIC_REPLY_TEXT=C'est envoyé, check tes DM
PROCESSED_COMMENTS_DATABASE=data/processed_comments.sqlite3
GRAPH_API_VERSION=v21.0

# X / Twitter
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
